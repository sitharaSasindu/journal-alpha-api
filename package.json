{
  "name": "journal-alpha-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create journal-alpha-db",
    "db:migrate:local": "wrangler d1 migrations apply journal-alpha-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply journal-alpha-db --remote"
  },
  "devDependencies": {
    "wrangler": "^3.114.0"
  }
}
